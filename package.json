{
  "name": "sleepy-doll-ui",
  "version": "0.1.0",
  "description": "A Codex-inspired, BGI-oriented local agent runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit && vite build",
    "format": "prettier --write \"web/**/*.{ts,tsx,css,html}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"web/**/*.{ts,tsx,css,html}\" \"*.{json,ts}\"",
    "dev": "vite",
    "desktop": "npm run build && cargo run --release",
    "mock": "cargo run --no-default-features --bin sleepy-doll-mock -- sleepy-doll.mock.config.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "vite": "^6.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
