    "segments": [
      {
        "start": 350,
        "end": 4650,
        "text": "用一句话，安排 Better GI 的日常任务。"
      },
      {
        "start": 5150,
        "end": 11800,
        "text": "输入目标。完成今天的委托，再检查结果。点击发送。"
      },
      {
        "start": 11900,
        "end": 16400,
        "text": "先整理步骤，再检查状态、运行路线、核对结果。"
      },
      {
        "start": 16550,
        "end": 20000,
        "text": "关键操作先确认，允许之后再执行。"
      },
      {
        "start": 20500,
        "end": 28300,
        "text": "任务交给 Better GI。窗口联动，执行状态和日志持续更新。每一步，都能看到进展。"
      },
      {
        "start": 29100,
        "end": 32300,
        "text": "执行结束，回到对话核对结果。"
      },
      {
        "start": 32900,
        "end": 39700,
        "text": "把已有的今日路线，保存为快捷任务。下次直接运行，不再调用模型。"
      },
      {
        "start": 42150,
        "end": 48800,
        "text": "支持多种模型协议。云端服务，或本地模型，都可以按需配置。"
      },
      {
        "start": 49400,
        "end": 53000,
        "text": "技能和插件，让工具能力按需扩展。"
      },
      {
        "start": 53300,
        "end": 56400,
        "text": "通过本地桥，连接原版 Better GI。"
      },
      {
        "start": 56700,
        "end": 59800,
        "text": "Sleepy Doll，你的 Better GI 本地助手。"
      }
    ]
  },
